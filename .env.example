# --- Tempest ---------------------------------------------------------------
# local, staging, production, ci, testing
ENVIRONMENT=local
BASE_URI=http://localhost:8000
DISCOVERY_CACHE=false

# --- Identity --------------------------------------------------------------
# The hostname this service is reachable at. The did:web service DID and the
# .well-known/did.json document are both derived from it.
FEEDGEN_HOSTNAME=localhost

# The DID of the account that publishes the feed record.
# https://bsky.social/xrpc/com.atproto.identity.resolveHandle?handle=YOUR_HANDLE
FEEDGEN_PUBLISHER_DID=did:plc:abcde...

# Only set this if the service DID is not did:web:$FEEDGEN_HOSTNAME. It must be
# stable: a token's `aud` is checked against it, so a value that changes on
# each deploy rejects every authenticated request afterwards.
# FEEDGEN_SERVICE_DID=did:web:feed.example.com

# --- Feed ------------------------------------------------------------------
# Record key (max 15 chars), shown in the feed's at:// URI.
FEEDGEN_RECORD_KEY=kodamachi
FEEDGEN_DISPLAY_NAME=Kodamachi
FEEDGEN_DESCRIPTION="Posts from around Kodamachi."

# PNG or JPEG uploaded as the feed's avatar by `php tempest feed:publish`.
# putRecord replaces the whole record, so publishing without this set removes
# any avatar the feed already has.
# FEEDGEN_AVATAR=var/avatar.png

# Comma-separated, case-insensitive substrings. A post is indexed when its text
# contains any FEEDGEN_MATCH_TEXT term, or an image's alt text contains any
# FEEDGEN_MATCH_ALT term.
FEEDGEN_MATCH_TEXT=kodamachi
FEEDGEN_MATCH_ALT=kodamachi

# Days to keep posts before pruning.
FEEDGEN_RETENTION_DAYS=30

# --- Storage ---------------------------------------------------------------
# Must be on a persistent volume in production. Railway's filesystem is
# ephemeral: a path outside a mounted volume is wiped on every deploy, taking
# the index and the cursor with it.
FEEDGEN_SQLITE_LOCATION=var/database.sqlite

# --- Ingestion -------------------------------------------------------------
# A bare host (the navyfragen-feed form) gets /subscribe appended.
FEEDGEN_SUBSCRIPTION_ENDPOINT=wss://jetstream1.us-east.bsky.network/subscribe
FEEDGEN_RECONNECT_DELAY_SECONDS=3

# --- Outgoing credentials --------------------------------------------------
# Used for the backfill search and for publishing the feed record. Without
# them the service still serves the feed; it just cannot recover posts it
# missed while it was down.
FEEDGEN_HANDLE=
FEEDGEN_APP_PASSWORD=
FEEDGEN_PDS_URL=https://bsky.social

# --- Auth ------------------------------------------------------------------
# Leave off. The skeleton is byte-identical for every requester, so requiring
# service auth adds no privacy and only decides which clients can load the
# feed at all -- and a client whose token is rejected shows its users a
# permanently empty feed.
FEEDGEN_REQUIRE_AUTH=false
FEEDGEN_PLC_DIRECTORY=https://plc.directory

# --- Logging ---------------------------------------------------------------
# stdout so the container runtime collects it.
FEEDGEN_LOG_PATH=php://stdout
