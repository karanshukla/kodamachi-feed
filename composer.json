{
    "name": "karanshukla/kodamachi-feed",
    "description": "Bluesky feed generator for Kodamachi, built on libphpsky + Tempest",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pcntl": "*",
        "tempest/framework": "^3.2.1",
        "aazsamir/libphpsky": "dev-main",
        "karanshukla/php-atproto-identity": "^1.0",
        "firebase/php-jwt": "^7.1"
    },
    "require-dev": {
        "ext-gmp": "*",
        "phpunit/phpunit": "^13.3.4",
        "symfony/var-dumper": "^7.3.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php ./vendor/bin/tempest discovery:generate --no-interaction"
        ],
        "phpunit": "vendor/bin/phpunit --display-warnings --display-deprecations"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
